#!/usr/bin/env bash
set -euo pipefail

# Commandes recopiées de .github/workflows/ci.yml (jobs fmt et clippy) : les
# garder identiques.
if ! cargo fmt --all --check; then
    echo "pre-commit : formatage non conforme. Lancer \`cargo fmt --all\`, puis recommiter." >&2
    exit 1
fi
cargo clippy --locked --all-targets -- -D warnings
